#pragma once
// GENERATED by CMake configure_file from gpu_profiles.h.in - DO NOT EDIT.
// Source of truth: the bitnet_compile_kernels_for calls in CMakeLists.txt
// (the same values are passed as slangc -D defines to the kernels).
// Never run clang-format on this .h.in template - it rewrites the
// @...@ CMake marker.

#include <cstring>
#include <string>

namespace bitnet {

struct GpuProfile {
    const char* match;             // exact DeviceCaps.device_name (case-insensitive); "" = default
    const char* profile_dir;       // subdirectory under the spv base dir
    unsigned gemv_threads;         // v3: cooperative-row workgroup size
    unsigned gemv6_threads;        // v6 gemv: cooperative-row workgroup size (own optimum)
    unsigned gemv_dot_threads;     // v5: packed-dot gemv workgroup size
    unsigned gemm_tile_m;          // v4: output tile rows
    unsigned gemm_tile_n;          // v4: output tile cols
    unsigned gemm_chunk;           // v4: words per K-chunk
    unsigned gemm_tile_threads;    // v4: must equal gemm_tile_m * gemm_tile_n
    unsigned gemv6_rows_per_group; // v6 gemv: output rows per workgroup (ROWS_PER_GROUP)
    unsigned gemm_v7_rows;         // v7: output rows per thread (GEMM_V7_RM)
    unsigned gemm_v7_cols;         // v7: output cols per thread (GEMM_V7_RN)
    unsigned gemm_v7_threads;      // v7: workgroup size (GEMM_V7_THREADS)
    const char* gemv_champion;     // measured decode (GEMV) kernel for this profile
    const char* gemm_champion;     // measured prefill (GEMM) kernel for this profile
};

// Validates a profile against the device's advertised limits.
inline bool gpu_profile_valid(const GpuProfile& p, unsigned max_workgroup,
                              unsigned max_shared_bytes, std::string* reason) {
    auto fail = [&](const std::string& msg) {
        if (reason) {
            *reason = msg;
        }
        return false;
    };
    if (p.gemm_tile_threads > max_workgroup) {
        return fail("gemm_tile_threads exceeds device workgroup limit");
    }
    if (p.gemm_tile_threads != p.gemm_tile_m * p.gemm_tile_n) {
        return fail("gemm_tile_threads must equal gemm_tile_m * gemm_tile_n");
    }
    if (p.gemv_threads > max_workgroup || p.gemv_dot_threads > max_workgroup) {
        return fail("gemv_threads exceeds device workgroup limit");
    }
    const unsigned shared_bytes =
        (p.gemm_tile_n * 2 + p.gemm_tile_m * 8) * p.gemm_chunk * sizeof(uint32_t);
    if (shared_bytes > max_shared_bytes) {
        return fail("groupshared tile storage exceeds device limit");
    }
    // v6 gemv: lanes_per_row = gemv6_threads / rows_per_group must stay >= 1
    // (gemv_plane_rowcoop divides numthreads by ROWS_PER_GROUP).
    if (p.gemv6_rows_per_group == 0U || p.gemv6_rows_per_group > p.gemv6_threads) {
        return fail("gemv6_rows_per_group must be in 1..gemv6_threads");
    }
    if (p.gemv6_threads > max_workgroup) {
        return fail("gemv6_threads exceeds device workgroup limit");
    }
    if (p.gemm_v7_rows == 0U || p.gemm_v7_cols == 0U) {
        return fail("gemm_v7_rows/cols must be >= 1");
    }
    if (p.gemm_v7_threads > max_workgroup) {
        return fail("gemm_v7_threads exceeds device workgroup limit");
    }
    return true;
}

inline std::string to_lower_copy(std::string s) {
    for (char& c : s) {
        if (c >= 'A' && c <= 'Z') {
            c = static_cast<char>(c - 'A' + 'a');
        }
    }
    return s;
}

// Resolves the profile for a device by EXACT (case-insensitive) name.
// Substring matching promoted any GPU whose name contained "Mali" or
// "NVIDIA" to knobs that were never measured on it; exact names keep
// unmeasured devices on the conservative default profile. Tuning a new GPU
// = adding a bitnet_compile_kernels_for row with its exact caps name.
inline const GpuProfile* gpu_profile_named(const std::string& profile_dir) {
    // Explicit benchmark sweeps use the generated row so host dispatch knobs
    // and the compiled SPIR-V always come from the same profile.
    static const GpuProfile kProfiles[] = {
// clang-format off
@BITNET_PROFILE_ROWS@
// clang-format on
    };
    for (const auto& p : kProfiles) {
        if (profile_dir == p.profile_dir) {
            return &p;
        }
    }
    return nullptr;
}

inline const GpuProfile* gpu_profile_for_device(const std::string& device_name) {
    const std::string device_lower = to_lower_copy(device_name);
    // GENERATED from the bitnet_compile_kernels_for calls in
    // CMakeLists.txt - the same values are passed as slangc -D defines.
    // Do not edit this table here; edit the CMake profile list.
    static const GpuProfile kProfiles[] = {
// clang-format off
@BITNET_PROFILE_ROWS@
// clang-format on
    };
    for (const auto& p : kProfiles) {
        if (!std::string(p.match).empty() && device_lower == to_lower_copy(p.match)) {
            return &p;
        }
    }
    // Fallback: the profile named "default" (single source of truth).
    for (const auto& p : kProfiles) {
        if (std::strcmp(p.profile_dir, "default") == 0) {
            return &p;
        }
    }
    return &kProfiles[0];
}

} // namespace bitnet
