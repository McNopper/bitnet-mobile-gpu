# C++ style for poc/ and any ggml-facing code. Close to llama.cpp conventions
# (4-space indent, generous column) so upstream diffs stay reviewable.
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: InlineOnly
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
